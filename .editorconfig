root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

# fixtures keep their bytes: CRLF, trailing spaces and non-UTF-8 are cases
[**/testdata/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
